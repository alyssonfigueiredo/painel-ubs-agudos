{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "painel-ubs",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-11",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /recepcao, /01, /vacina... não são arquivos: serve o index.html e o JS lê o caminho
    "not_found_handling": "single-page-application",
    // TUDO passa pelo Worker (src/worker.js): /tts vira MP3, /versao.js sai com
    // no-store e o resto vai pros assets. Com a lista parcial, o /tts chegou a receber
    // o index.html no lugar do áudio (NotSupportedError na TV).
    "run_worker_first": true
  },
  // limpeza diária: chamados às 18h de Brasília (21:00 UTC, retenção de 3 dias) e
  // mensagens entre consultórios às 17h (20:00 UTC, zera tudo todo dia — ver scheduled()
  // em src/worker.js, que decide o que fazer por event.cron)
  "triggers": { "crons": ["0 20 * * *", "0 21 * * *"] },
  "routes": [
    { "pattern": "painel-ubs.soaperando.com.br", "custom_domain": true }
  ]
}
