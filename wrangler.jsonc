{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "painel-ubs",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-11",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /recepcao, /01, /vacina... não são arquivos: serve o index.html e o JS lê o caminho
    "not_found_handling": "single-page-application",
    // caminhos que SEMPRE passam pelo Worker: /tts (senão o modo página única
    // devolve o index.html no lugar do MP3) e /versao.js (sai com no-store)
    "run_worker_first": ["/tts", "/versao.js"]
  },
  // limpeza diária dos chamados às 18h de Brasília (UTC-3, sem horário de verão) = 21:00 UTC
  "triggers": { "crons": ["0 21 * * *"] },
  "routes": [
    { "pattern": "painel-ubs.soaperando.com.br", "custom_domain": true }
  ]
}
